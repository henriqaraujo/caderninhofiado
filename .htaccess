# Mantém o Caderninho do Fiado independente do site principal (public_html).
# Sem isto, regras de redirecionamento do site principal podem valer aqui também.
RewriteEngine On

DirectoryIndex index.html

# Arquivos do sistema sempre atualizados no navegador
<FilesMatch "\.(html|js|css|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
